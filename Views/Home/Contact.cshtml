
@{
    ViewData["Title"] = "Contacto |";
}

<section class="catalogo-encabezado">
    <h1>Contáctanos</h1>
</section>

<section class="contacto-lista">

    <article class="contacto-card">
        <div class="contacto-card-cabecera">
            <div>
                <p class="contacto-sucursal">ENLETRADOS</p>
                <h2>Matriz</h2>
            </div>
        </div>

        <div class="contacto-card-cuerpo">
            <div class="contacto-dato">
                <span>Correo electrónico</span>
                <a href="mailto:contacto@enletrados.com">
                    contacto@enletrados.com
                </a>
            </div>

            <div class="contacto-dato">
                <span>Teléfono</span>
                <p>---</p>
            </div>

            <div class="contacto-dato">
                <span>Dirección</span>
                <p>---</p>
            </div>

            <div class="contacto-dato">
                <span>Horario de atención</span>
                <p>---</p>
            </div>
        </div>
    </article>

</section>
